{
  "name": "garage-flow-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:bootstrap-admin": "ts-node -r tsconfig-paths/register prisma/bootstrap-admin.ts",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug 0.0.0.0:9229 --watch",
    "start:prod": "node dist/src/main",
    "sonar": "dotenv -e .env -- sonar-scanner-npm",
    "sonar:full": "npm run test:cov && npm run sonar",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "pretest": "prisma generate",
    "test": "jest --setupFiles dotenv/config --runInBand",
    "test:watch": "jest --watch --setupFiles dotenv/config --runInBand",
    "test:cov": "jest --coverage --setupFiles dotenv/config --runInBand",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "prepare": "husky",
    "docs:openapi": "node scripts/export-openapi.js",
    "docs:collection": "node scripts/generate-postman-collection.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nodemailer": "^10.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^30.5.2",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.7",
    "@sonar/scan": "^5.0.2",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.0.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "prettier": "^3.4.2",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^12.1.0",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "globalSetup": "<rootDir>/test/support/global-setup.ts",
    "globalTeardown": "<rootDir>/test/support/global-teardown.ts",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@service/(.*)$": "<rootDir>/src/modules/service/$1",
      "^@auth/(.*)$": "<rootDir>/src/modules/auth/$1",
      "^@generated/prisma/(.*)$": "<rootDir>/generated/prisma/$1",
      "^@inventory/(.*)$": "<rootDir>/src/modules/inventory/$1",
      "^@common/(.*)$": "<rootDir>/src/common/$1",
      "^@infra/(.*)$": "<rootDir>/src/infra/$1",
      "^@client/(.*)$": "<rootDir>/src/modules/client/$1",
      "^@vehicle/(.*)$": "<rootDir>/src/modules/vehicle/$1",
      "^@service-orders/(.*)$": "<rootDir>/src/modules/service-orders/$1",
      "^@notification/(.*)$": "<rootDir>/src/modules/notification/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/main.ts",
      "!src/**/*.module.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "deepmerge": "4.1.1",
    "glob": "14.0.3",
    "minimatch": "11.0.3",
    "node-forge": "1.4.2",
    "tmp": "0.2.7",
    "webpack": "5.112.2",
    "js-yaml": "4.3.2",
    "deepmerge-ts": "8.0.0",
    "test-exclude": "8.0.0",
    "multer": "2.5.0",
    "body-parser": "2.4.0"
  }
}
